{
  "name": "@wangyong1972/dsh-quota-dashboard",
  "version": "0.1.0",
  "description": "Draggable quota/cost dashboard for the dsh web GUI: combines OpenRouter and DeepSeek balances and spend (official APIs + local ledger) in one movable card.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "openrouter",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "quota",
    "balance",
    "usage",
    "dashboard",
    "web"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.0.1-rc.1"
  }
}
